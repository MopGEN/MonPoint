<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- Datos de conexión -->
        <property name="hibernate.connection.driver_class">org.mariadb.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mariadb://localhost:3306/monpointv2</property>

        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">admin</property>

        <!-- Dialecto específico de MariaDB -->
        <property name="hibernate.dialect">org.hibernate.dialect.MariaDBDialect</property>

        <!-- Mostrar SQL en consola -->
        <property name="hibernate.show_sql">true</property>

        <!-- Control de formato SQL -->
        <property name="hibernate.format_sql">true</property>

        <!-- Mapeos de entidades -->
        <mapping class="entidades.Usuario"/>
        <mapping class="entidades.Cliente"/>
        <mapping class="entidades.Producto"/>
<mapping class="entidades.Proveedor"/>

        <mapping class="entidades.Venta"/>
        <mapping class="entidades.DetalleVenta"/>


        <!-- 🔥 nuevo mapeo correcto -->
        <mapping class="entidades.Configuracion"/>

    </session-factory>
</hibernate-configuration>
