# intelliJ IDEA (ugous pc)
# Carpeta generada automaticamente por intellij
.idea/

# Archivos redundantes y especificos de cada maquina
*.iml

# Maven
# Directorio de salida donde Maven almacena los archivos binarios compilados
**/target/

# Sistema operativo
# Archivos ocultos que crean Finder (macOS) y el Explorador (Windows)
.DS_Store
Thumbs.db
desktop.ini

# Archivos locales de la app
**/sesion.dat
**/clave.key

# Contexto y configuracion de Claude Code / MCP
CLAUDE.md
CLAUDE.local.md
.claude/
.claude.json
.mcp.json

# Variables de entorno: el .env real y cualquier variante (.env.local, .env.prod,
# .env.bak...). Solo se versiona el ejemplo, que no lleva valores reales.
.env
*.env
*.env.local
.env.*
!.env.example

# Llaves privadas, certificados y almacenes de claves, en cualquier carpeta.
# Una clave que entra al historial queda ahi aunque se borre despues: MonPointV2
# subio su clave.key en el primer commit y sigue recuperable desde el historial.
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*

# Compilados de Java (ademas de **/target/)
*.class
*.jar
*.war
!**/.mvn/wrapper/maven-wrapper.jar

# IDEs extras (evitar problemas futuros)
.vscode/
.settings/
.classpath
.project

# Logs de ejecucion de datos; evitar filtracion de datos
*.log
logs/

# skills1 
.agents/
skills-lock.json
*.visual-check.*

# Planes locales temporales
plan_implementacion_ms_auth.md
dependencies.md