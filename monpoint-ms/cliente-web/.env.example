# Direccion del api-gateway. Es la UNICA direccion que conoce el cliente web:
# los microservicios no se exponen al navegador.
#
# Vite solo expone al codigo del navegador las variables con prefijo VITE_, y
# las sustituye en tiempo de compilacion (no se leen en ejecucion). Cambiar este
# valor exige volver a compilar; el empaquetado de la tarea 5.6 lo tiene en
# cuenta.
VITE_GATEWAY_URL=http://localhost:8080
