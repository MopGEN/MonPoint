# =============================================================================
# MonPoint MS — Variables de entorno (PLANTILLA)
# =============================================================================
# Este archivo SI se versiona: sirve de referencia para saber que variables
# hacen falta.
#
# PARA USARLO:
#   1. Copiarlo:  cp .env.example .env
#   2. Cambiar los valores del archivo .env
#   3. El .env real NO se versiona (esta en .gitignore)
#
# POR QUE ESTA SEPARACION
# El Documento 02, requisito RNF-06, exige que ninguna credencial aparezca
# en el repositorio. Ademas, MonPointV2 tenia este problema exacto: la clave
# de cifrado y el archivo de sesion estaban versionados. Es uno de los
# defectos que esta migracion corrige.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB — usuario administrador
# -----------------------------------------------------------------------------
# Solo se usa para administrar el servidor y ejecutar el guion de
# inicializacion. Los servicios NO usan estas credenciales: cada uno tiene su
# propio usuario, con permiso unicamente sobre su base.
MONGO_ROOT_USER=monpoint_admin
MONGO_ROOT_PASSWORD=cambiar_esta_clave

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
# Estas credenciales sirven tanto para la consola web (puerto 15672) como
# para la conexion de los servicios (puerto 5672).
RABBITMQ_USER=monpoint
RABBITMQ_PASSWORD=cambiar_esta_clave

# -----------------------------------------------------------------------------
# JWT — clave de firma
# -----------------------------------------------------------------------------
# ms-auth firma los tokens con esta clave; el Gateway verifica la firma con
# la misma. Por eso debe ser IDENTICA en ambos.
#
# Longitud minima: 32 caracteres. El algoritmo HS256 exige una clave de al
# menos 256 bits, y una mas corta produce un error al arrancar.
#
# Limitacion aceptada, documentada en el Documento 02 seccion 8.3: al ser
# una clave compartida, cualquiera que la tenga puede emitir tokens validos.
# En un sistema de produccion se usarian claves asimetricas (una privada para
# firmar, una publica para verificar). Para el alcance de este proyecto, la
# clave compartida es suficiente y mucho mas simple.
JWT_SECRET=cambiar_esta_clave_debe_tener_al_menos_32_caracteres

# -----------------------------------------------------------------------------
# CORS — origenes autorizados
# -----------------------------------------------------------------------------
# Lista separada por comas de los origenes que pueden llamar a la API desde
# un navegador.
#
# QUE ES CORS Y POR QUE HACE FALTA
# Un navegador bloquea por omision que una pagina servida desde un origen
# (http://localhost:5173) llame a otro distinto (http://localhost:8080).
# Es una proteccion del navegador contra que cualquier sitio haga peticiones
# en tu nombre a otro sitio donde tengas sesion abierta.
#
# El servidor tiene que autorizar explicitamente el origen desde el que
# acepta llamadas. Eso es CORS.
#
# MonPointV2 no lo necesitaba porque era una aplicacion de escritorio: no
# habia navegador que impusiera esa restriccion. Es un concepto nuevo que
# aparece unicamente porque el cliente pasa a ser web.
#
# 5173 es el puerto de Vite en desarrollo; el otro es el del contenedor.
CORS_ORIGENES=http://localhost:5173,http://localhost:3000
