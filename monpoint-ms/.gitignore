# =============================================================================
# MonPoint MS — Archivos excluidos del control de versiones
# =============================================================================

# -----------------------------------------------------------------------------
# Credenciales — lo mas importante de este archivo
# -----------------------------------------------------------------------------
# El .env real contiene claves; el .env.example no y por eso si se versiona.
.env
*.env
.env.*
!.env.example

# Claves, certificados y almacenes de claves, por si alguno aparece durante el
# desarrollo. Una clave que entra al historial queda ahi aunque se borre despues.
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*

# -----------------------------------------------------------------------------
# Compilacion de Java / Maven
# -----------------------------------------------------------------------------
# MonPointV2 tenia el directorio target/ versionado: duplicaba clases
# compiladas, recursos y hojas de estilo dentro del repositorio. Es uno de
# los hallazgos del analisis de codigo (Documento 02, seccion 3.3).
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# -----------------------------------------------------------------------------
# Node / Vue (cliente web, a partir de la semana 5)
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# -----------------------------------------------------------------------------
# Entornos de desarrollo
# -----------------------------------------------------------------------------
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath

# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Registros y temporales
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/

# -----------------------------------------------------------------------------
# Contexto y configuracion de Claude Code / MCP / Planes locales
# -----------------------------------------------------------------------------
CLAUDE.md
CLAUDE.local.md
.claude/
.claude.json
.mcp.json
plan_implementacion_ms_auth.md
dependencies.md

