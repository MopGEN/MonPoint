      {
        "id": "gateway-pipeline",
        "label": "2. API Gateway (:8080 — 6 Pasos)",
        "focus": ["client", "gw_entry", "gw_jwt", "gw_lb", "eureka", "auth_sec"],
        "note": "Recorrido reactivo: RequestId -> CORS -> Ruta WebFlux -> Filtro JWT HS256 -> LoadBalancer -> ms-auth."
      },
      {
        "id": "auth-login",
        "label": "3. Login, BCrypt y JWT en ms-auth",
        "focus": ["gw_lb", "auth_sec", "auth_ctrl", "auth_svc", "user_svc", "auth_repo", "mongo"],
        "note": "Login manual con BCrypt(12), hashFicticio anti-enumeración y firma explícita Jwts.SIG.HS256."
      },
      {
        "id": "crud-tx-audit",
        "label": "4. Usuarios, Transacciones y Auditoría",
        "focus": ["auth_sec", "auth_ctrl", "user_svc", "audit_bus", "auth_repo", "mongo"],
        "note": "Validación JWT en memoria, 403 antes de 404, PasswordValidator (8-72B) y transacciones en Replica Set rs0."
      },
      {
        "id": "rfc9457-errors",
        "label": "5. Manejo de Errores RFC 9457",
        "focus": ["gw_entry", "gw_jwt", "auth_sec", "auth_ctrl", "auth_advice"],
        "note": "Respuestas uniformes application/problem+json con requestId tanto en el Gateway como en ms-auth."
      }
